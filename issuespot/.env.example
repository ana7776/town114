# Cloudflare R2 S3-compatible credentials
# Free-first mode: leave these blank until you intentionally enable R2 uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional: public CDN/custom domain used in the generated manifest.
# Leave blank while using local-only/free-first image optimization.
R2_PUBLIC_BASE_URL=

# Optional defaults for the image pipeline
IMAGE_SOURCE_URLS=https://example.com/page-a,https://example.com/page-b
IMAGE_SOURCE_FILE=image-sources.txt
IMAGE_R2_PREFIX=images/crawled
IMAGE_OUTPUT_DIR=.cache/images
IMAGE_MAX_WIDTH=1200
IMAGE_WEBP_QUALITY=80
IMAGE_CONCURRENCY=2
IMAGE_MAX_IMAGES=20
IMAGE_FETCH_TIMEOUT_MS=20000
IMAGE_USER_AGENT=IssueSpotImageBot/0.1
